# NÃO preencha à mão: rode `python scripts/gen_env.py --email voce@exemplo.com [--domain seudominio.com.br]`,
# que cria o .env com segredos aleatórios. Este arquivo só documenta as variáveis.
DOMAIN=localhost

# Segredos (gerados)
SALT=
ENCRYPTION_KEY=          # 64 caracteres hex
NEXTAUTH_SECRET=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=

# Bootstrap do primeiro start (organização, projeto, chaves e administrador)
LANGFUSE_INIT_ORG_ID=portfolio
LANGFUSE_INIT_ORG_NAME=Portfolio
LANGFUSE_INIT_PROJECT_ID=portfolio-chat
LANGFUSE_INIT_PROJECT_NAME=portfolio-chat
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# Opcional
# AUTH_DISABLE_SIGNUP=true
# LANGFUSE_PORT=3300
# CLICKHOUSE_MEM=3584m   # tetos somam 8 GiB (orçamento do Langfuse numa VPS de 16 GB); veja scripts/check_memory_budget.py
# WEB_MEM=1536m
# WORKER_MEM=1g
# POSTGRES_MEM=1g
# REDIS_MEM=512m
# MINIO_MEM=512m
