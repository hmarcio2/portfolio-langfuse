# Interface do Langfuse em langfuse.SEUDOMINIO. Instalado em /opt/edge/sites/langfuse.caddy pelo deploy.
# Os apps NÃO passam por aqui: enviam os traces pela rede interna (http://langfuse-web:3000).
langfuse.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy langfuse-web:3000 {
		flush_interval -1
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}
